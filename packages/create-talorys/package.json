{
  "name": "create-talorys",
  "version": "0.1.7",
  "description": "Deploy Talorys — your personal AI agent — into your own Cloudflare account with one command.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-talorys": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cloudflare",
    "ai-agent",
    "personal-assistant",
    "workers",
    "durable-objects",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rociiu/talorys.git",
    "directory": "packages/create-talorys"
  },
  "scripts": {
    "build": "tsup && node scripts/build-templates.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:pack": "node test/pack-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "wrangler": "4.149.0"
  },
  "devDependencies": {
    "@talorys/shared": "*",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
