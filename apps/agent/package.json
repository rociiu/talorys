{
  "name": "@talorys/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --persist-to ../../.wrangler/state",
    "dev:remote-ai": "wrangler dev --port 8787 --persist-to ../../.wrangler/state --var TALORYS_MOCK_AI:0",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@talorys/shared": "*",
    "agents": "^0.28.0",
    "ai": "^7.0.137",
    "eventsource-parser": "^3.1.1",
    "hono": "^4.13.13",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
